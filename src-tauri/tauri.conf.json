{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ETS2 Dashboard Editor",
  "version": "0.1.0",
  "identifier": "com.metehan.ets2-dashboard-editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ETS2 Dashboard Editor",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "../icon.ico",
      "../icon.png"
    ],
    "resources": {
      "../sdk_dll/scsdashboardeditor.dll": "scsdashboardeditor.dll"
    },
    "windows": {
      "wix": {},
      "nsis": {}
    }
  }
}
