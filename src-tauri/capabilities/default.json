{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for ETS2 Dashboard Editor",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-read-text-file",
    "fs:scope-home-recursive",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "opener:default"
  ]
}
